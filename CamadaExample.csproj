<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>12</LangVersion>
    <AssemblyName>CamadaExample</AssemblyName>
    <RootNamespace>CamadaExample</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- the sibling checkout, like the npm examples' file: deps and the Python example's path dependency -->
    <ProjectReference Include="../camada-dotnet/src/Camada/Camada.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the test project lives under tests/: keep its sources out of the app's default globs -->
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

</Project>
